<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <ForgeLifecycleSource Condition="'$(ForgeLifecycleSource)' == ''">$(MSBuildThisFileDirectory)..\..\src\Nicokobo.Forge\ForgeLifecycleApi.cs</ForgeLifecycleSource>
    <ForgeMachineHooksSource Condition="'$(ForgeMachineHooksSource)' == ''">$(MSBuildThisFileDirectory)..\..\src\Nicokobo.Forge\ForgeMachineHooks.cs</ForgeMachineHooksSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ForgeLifecycleSource)" Link="Production/ForgeLifecycleApi.cs" />
    <Compile Include="../../src/Nicokobo.Forge/ForgePresentationApi.cs" Link="Production/ForgePresentationApi.cs" />
    <Compile Include="../../src/Nicokobo.Forge/Runtime/OwnedCallbacks.cs" Link="Production/OwnedCallbacks.cs" />
    <Compile Include="../../BuildConfig/ForgeNumbers.cs" Link="Production/ForgeNumbers.cs" />
    <Compile Include="$(ForgeMachineHooksSource)" Link="Production/ForgeMachineHooks.cs" />
    <Compile Include="../../src/Nicokobo.Forge/ForgeMachineRuntime.cs" Link="Production/ForgeMachineRuntime.cs" />
    <Compile Include="../../src/Nicokobo.Forge/ForgeMachineModels.cs" Link="Production/ForgeMachineModels.cs" />
    <Compile Include="../../src/Nicokobo.Forge/MachineTransaction.cs" Link="Production/MachineTransaction.cs" />
  </ItemGroup>
</Project>
